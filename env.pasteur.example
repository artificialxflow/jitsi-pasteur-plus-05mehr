# Merge into /opt/jitsi/.env after cp env.example .env
# Do not commit a real .env with secrets.
# Prefer: scripts/bootstrap-vps.sh (sets these automatically).

PUBLIC_URL=https://meet.pasteur-plus.com

ENABLE_AUTH=1
ENABLE_GUESTS=0
AUTH_TYPE=jwt

JWT_APP_ID=pasteur_plus
JWT_APP_SECRET=REPLACE_WITH_openssl_rand_hex_32
JWT_ACCEPTED_ISSUERS=pasteur_plus
JWT_ACCEPTED_AUDIENCES=pasteur_plus

TZ=Asia/Tehran

# TLS (docker-jitsi-meet Let's Encrypt)
ENABLE_LETSENCRYPT=1
LETSENCRYPT_DOMAIN=meet.pasteur-plus.com
LETSENCRYPT_EMAIL=admin@pasteur-plus.com
ENABLE_HTTP_REDIRECT=1

# Public IP of this VPS (auto-set by install script if empty)
# JVB_ADVERTISE_IPS=45.159.150.159

# JVB UDP — confirm in .env after install (often JVB_PORT=10000)
